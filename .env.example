# Application Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_ENV=development

# Server Configuration
PORT=8080
TRUSTED_PROXIES=127.0.0.1,::1

# JWT Configuration
# IMPORTANT: Generate a secure random secret with: openssl rand -base64 32
# Never use the same secret in different environments (dev/staging/prod)
JWT_SECRET=GENERATE_A_RANDOM_SECRET_HERE
JWT_EXP_MINUTES=15
REFRESH_EXP_HOURS=168

# PostgreSQL Database Credentials (used by docker-compose)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Database Configuration
# For local development: postgresql://username:password@localhost:5432/dbname?sslmode=disable
# For Docker: postgresql://username:password@postgres:5432/dbname?sslmode=disable
DATABASE_URL=postgresql://username:password@localhost:5432/dbname?sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Monitoring (Grafana) - Only needed when running with Docker
GRAFANA_PASSWORD=admin
