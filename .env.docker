# Application Environment Configuration for Docker
# Copy this file to .env for docker-compose
# This file is used by both docker-compose and the application via Viper

# Application
APP_ENV=development

# Server Configuration
PORT=8080
TRUSTED_PROXIES=0.0.0.0/0

# JWT Configuration
# IMPORTANT: Generate a new secret with: openssl rand -base64 32
# This is a template - you MUST change this for production!
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION
JWT_EXP_MINUTES=15
REFRESH_EXP_HOURS=168

# PostgreSQL Database Credentials (used by docker-compose)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_DB=mini_ecommerce

# Database Configuration
# Note: DATABASE_URL is constructed in docker-compose.yml using above credentials
DATABASE_URL=postgresql://ecommerce:ecommerce_password@postgres:5432/mini_ecommerce?sslmode=disable

# Redis Configuration
# Note: REDIS_ADDR is set in docker-compose.yml to use Docker service names
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Monitoring (Grafana)
GRAFANA_PASSWORD=admin
