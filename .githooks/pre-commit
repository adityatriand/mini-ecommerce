#!/bin/bash

set -e

echo "Running pre-commit tests..."

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    echo "No Go files staged, skipping tests"
    exit 0
fi

# Collect unique packages from staged Go files
PACKAGES_TO_TEST=""
PACKAGE_DIRS=()

for file in $STAGED_GO_FILES; do
    # Extract the directory (package) from the file path
    package_dir=$(dirname "$file")

    # Only process if it's a Go package (contains .go files)
    if [[ -d "$package_dir" ]]; then
        # Check if this package has test files
        if ls "$package_dir"/*_test.go 1> /dev/null 2>&1; then
            # Add package if not already in the list
            if [[ ! " ${PACKAGE_DIRS[@]} " =~ " ${package_dir} " ]]; then
                PACKAGE_DIRS+=("$package_dir")
                PACKAGES_TO_TEST="$PACKAGES_TO_TEST ./$package_dir"
            fi
        fi
    fi
done

if [ -z "$PACKAGES_TO_TEST" ]; then
    echo "No testable packages affected by changes"
    exit 0
fi

echo "Running tests for affected packages with test files:$PACKAGES_TO_TEST"

for package in $PACKAGES_TO_TEST; do
    echo ""
    echo "=========================================="
    echo "Testing $package..."
    echo "=========================================="
    if ! go test $package -v; then
        echo ""
        echo "❌ Tests failed for $package"
        echo "Commit aborted. Please fix the tests before committing."
        exit 1
    fi
done

echo ""
echo "✅ All tests passed!"
exit 0
